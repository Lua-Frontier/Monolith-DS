<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:luaShipyard="clr-namespace:Content.Client._Lua.Shipyard.UI"
                      xmlns:luamShipyard="clr-namespace:Content.Client._LuaM.Shipyard.UI"
                      MinSize="1100 640"
                      SetSize="1440 820">
    <!-- LuaM: layout rebuilt around the live ship preview: catalog, preview, ship data with the dock radar, bottom bar -->
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      SeparationOverride="6"
                      Margin="4 4 4 0">
            <!-- Catalog -->
            <BoxContainer Orientation="Vertical" SetWidth="290" SeparationOverride="3">
                <LineEdit Name="SearchBar"
                          PlaceHolder="{Loc 'cargo-console-menu-search-bar-placeholder'}"
                          HorizontalExpand="True"/>
                <OptionButton Name="Categories"
                              Prefix="{Loc 'shipyard-console-menu-size-label'}"
                              HorizontalExpand="True"/>
                <OptionButton Name="Classes"
                              Prefix="{Loc 'shipyard-console-menu-class-label'}"
                              HorizontalExpand="True"/>
                <OptionButton Name="Engines"
                              Prefix="{Loc 'shipyard-console-menu-engine-label'}"
                              HorizontalExpand="True"/>
                <Label Name="CatalogTitle" Margin="2 4 0 0" FontColorOverride="#9BA6AD"/>
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BorderColor="#444444" BorderThickness="2"/>
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                        <BoxContainer Name="Vessels" Orientation="Vertical" Margin="2"/>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
            <!-- Preview -->
            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BorderColor="#444444" BorderThickness="2"/>
                </PanelContainer.PanelOverride>
                <Control Margin="2" HorizontalExpand="True" VerticalExpand="True">
                    <luamShipyard:ShipyardPreviewView Name="PreviewView" Access="Public"/>
                    <PanelContainer HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8 6">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0B1118D9"
                                              BorderColor="#2D4757"
                                              BorderThickness="1"
                                              ContentMarginLeftOverride="10"
                                              ContentMarginRightOverride="12"
                                              ContentMarginTopOverride="4"
                                              ContentMarginBottomOverride="6"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical">
                            <Label Name="PreviewTitle" StyleClasses="LabelHeadingBigger"/>
                            <Label Name="PreviewSubtitle" FontColorOverride="#B8C2C9"/>
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer Name="PreviewStatusPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visible="False">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0B1118E6"
                                              BorderColor="#2D4757"
                                              BorderThickness="1"
                                              ContentMarginLeftOverride="12"
                                              ContentMarginRightOverride="12"
                                              ContentMarginTopOverride="6"
                                              ContentMarginBottomOverride="6"/>
                        </PanelContainer.PanelOverride>
                        <Label Name="PreviewStatus" FontColorOverride="#E0E6EC"/>
                    </PanelContainer>
                    <BoxContainer Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  SeparationOverride="4"
                                  Margin="10">
                        <Button Name="PreviewFitButton" Text="{Loc 'shipyard-preview-fit'}"/>
                        <Button Name="PreviewZoomOutButton" Text="−" MinWidth="32"/>
                        <Button Name="PreviewZoomInButton" Text="+" MinWidth="32"/>
                    </BoxContainer>
                </Control>
            </PanelContainer>
            <!-- Ship data and dock selection -->
            <BoxContainer Name="InfoColumn" Orientation="Vertical" SetWidth="330" SeparationOverride="6">
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BorderColor="#444444" BorderThickness="2"/>
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="10 6" SeparationOverride="4">
                            <BoxContainer Orientation="Horizontal">
                                <Label Name="InfoName" StyleClasses="LabelHeading" HorizontalExpand="True" ClipText="True"/>
                                <Label Name="InfoSize" FontColorOverride="#9BA6AD"/>
                            </BoxContainer>
                            <BoxContainer Name="InfoGrid" Orientation="Vertical" SeparationOverride="2"/>
                            <Label Text="{Loc 'shipyard-info-description'}" StyleClasses="LabelHeading" Margin="0 6 0 0"/>
                            <RichTextLabel Name="InfoDescription" HorizontalExpand="True"/>
                            <Label Text="{Loc 'shipyard-info-layout'}" StyleClasses="LabelHeading" Margin="0 6 0 0"/>
                            <BoxContainer Name="LayoutGrid" Orientation="Vertical" SeparationOverride="2"/>
                            <RichTextLabel Name="InfoNote" HorizontalExpand="True" Margin="0 6 0 0"/>
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
                <BoxContainer Name="DockBox" Orientation="Vertical" SeparationOverride="2">
                    <Label Text="{Loc 'shipyard-dock-title'}" FontColorOverride="#9BA6AD"/>
                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderColor="#444444" BorderThickness="2"/>
                        </PanelContainer.PanelOverride>
                        <luaShipyard:ShipyardDockRadarControl Name="DockRadar"
                                                              MinSize="250 250"
                                                              Margin="2"/>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
        <!-- Bottom bar: ID card, purchase, sale and the registered shuttle -->
        <BoxContainer Name="ShipManagement" Orientation="Vertical" Margin="4 4 4 0" SeparationOverride="2">
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="TargetIdButton"
                        Access="Public"
                        MinWidth="150"
                        MinHeight="28"
                        VerticalAlignment="Center"
                        Text="{Loc 'id-card-console-window-insert-button'}"/>
                <controls:ConfirmButton Name="PurchaseButton"
                                        Access="Public"
                                        HorizontalExpand="True"
                                        MinHeight="28"
                                        VerticalAlignment="Center"
                                        Text="{Loc 'shipyard-console-purchase-available'}"
                                        Disabled="True"/>
                <controls:ConfirmButton Name="SellShipButton"
                                        HorizontalExpand="True"
                                        MinHeight="28"
                                        VerticalAlignment="Center"
                                        Text="{Loc 'shipyard-console-sell'}"
                                        ConfirmationText="{Loc 'shipyard-console-confirm-unassign'}"
                                        Disabled="True"/>
                <controls:ConfirmButton Name="UnassignDeedButton"
                                        HorizontalExpand="True"
                                        MinHeight="28"
                                        VerticalAlignment="Center"
                                        Text="{Loc 'shipyard-console-unassign-deed'}"
                                        ConfirmationText="{Loc 'shipyard-console-confirm-unassign'}"
                                        Disabled="True"/>
                <PanelContainer MinWidth="220" Margin="8 0 0 0" VerticalAlignment="Center">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#18344AF0"
                                          BorderColor="#2EA7D0"
                                          BorderThickness="1"
                                          ContentMarginLeftOverride="10"
                                          ContentMarginRightOverride="10"
                                          ContentMarginTopOverride="2"
                                          ContentMarginBottomOverride="2"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="{Loc 'shipyard-bar-price'}" FontColorOverride="#9BA6AD" VerticalAlignment="Center"/>
                        <Label Name="SelectedPriceLabel"
                               StyleClasses="LabelHeading"
                               FontColorOverride="#7FE3FF"
                               HorizontalExpand="True"
                               Align="Right"
                               VerticalAlignment="Center"/>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="6" MinHeight="26">
                <Label Text="{Loc 'bank-atm-menu-balance-label'}" FontColorOverride="Silver" VerticalAlignment="Center"/>
                <Label Name="BalanceLabel" Text="{Loc 'shipyard-console-no-bank'}" VerticalAlignment="Center"/>
                <!-- LuaM: cash in the console, spent before the bank account -->
                <Label Name="CashTextLabel" Text="{Loc 'shipyard-console-cash-label'}" FontColorOverride="Silver" Margin="12 0 0 0" VerticalAlignment="Center" Visible="False"/>
                <Label Name="CashLabel" VerticalAlignment="Center" Visible="False"/>
                <Label Text="{Loc 'shipyard-console-deed-label'}" FontColorOverride="Silver" Margin="12 0 0 0" VerticalAlignment="Center"/>
                <Label Name="DeedTitle" VerticalAlignment="Center"/>
                <Label Text="{Loc 'shipyard-console-appraisal-label'}" FontColorOverride="Silver" Margin="12 0 0 0" VerticalAlignment="Center"/>
                <Label Name="ShipAppraisalLabel" Text="{Loc 'shipyard-console-no-deed'}" HorizontalExpand="True" ClipText="True" VerticalAlignment="Center"/>
                <BoxContainer Orientation="Horizontal"
                              Name="RenameContainer"
                              SetWidth="330">
                    <LineEdit Name="RenameLineEdit"
                              HorizontalExpand="True"
                              PlaceHolder="{Loc 'shipyard-console-rename-placeholder'}"
                              Editable="False"/>
                    <Button Name="RenameButton"
                            Margin="3 0 0 0"
                            Text="{Loc 'shipyard-console-rename-button'}"
                            Disabled="True"/>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Name="NoDeedHelperContainer" SeparationOverride="4">
                <Label Text="{Loc 'shipyard-console-no-idcard-helper-line1'}" FontColorOverride="#9BA6AD"/>
                <Label Text="{Loc 'shipyard-console-no-idcard-helper-line2'}" FontColorOverride="#9BA6AD"/>
            </BoxContainer>
        </BoxContainer>
        <!-- Footer -->
        <BoxContainer Orientation="Vertical" Margin="0 2 0 0">
            <PanelContainer StyleClasses="LowDivider"/>
            <BoxContainer Orientation="Horizontal"
                          Margin="10 2 5 0"
                          VerticalAlignment="Bottom">
                <Label Text="{Loc 'shipyard-console-hint'}"
                       StyleClasses="WindowFooterText"
                       HorizontalAlignment="Left"
                       Margin="0 0 5 0" />
                <Label Text="{Loc 'shipyard-console-version'}"
                       StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right"
                       HorizontalExpand="True"
                       Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"
                             SetSize="19 19"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
