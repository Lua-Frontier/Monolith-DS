<ContainerButton xmlns="https://spacestation14.io"
                 HorizontalExpand="True"
                 ToggleMode="True"
                 StyleClasses="button"
                 Margin="0 0 0 2">
    <!-- LuaM: the row only selects a vessel; purchase moved to the bottom bar of the console -->
    <BoxContainer Orientation="Horizontal"
                  HorizontalExpand="True"
                  Margin="6 3">
        <Label Name="VesselName"
               Access="Public"
               ClipText="True"
               HorizontalExpand="True" />
        <Label Name="LimitedCount"
               Access="Public"
               Visible="False"
               Margin="6 0 0 0"
               FontColorOverride="#D4B04C" />
        <Label Name="CategoryLabel"
               Access="Public"
               Margin="6 0 0 0"
               FontColorOverride="#9BA6AD" />
    </BoxContainer>
</ContainerButton>
