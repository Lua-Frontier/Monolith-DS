<!-- LuaM: palette colors -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Join Game"
                      SetSize="800 600">

    <BoxContainer Orientation="Vertical">
        <PanelContainer VerticalExpand="False" HorizontalExpand="True" Margin="6 6 6 6">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="3" BorderColor="#3D484D" BackgroundColor="#07090A"/>
            </PanelContainer.PanelOverride>
            <PanelContainer VerticalExpand="False" HorizontalExpand="True" Margin="0 0 0 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BorderThickness="3" BorderColor="#2A3236" BackgroundColor="#07090A"/>
                </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="1 1">
            <Button Name="StationTabButton"
                    MinSize="180 40"
                    StyleClasses="ButtonSquare"
                    HorizontalExpand="True">
                <Label Name="StationTabLabel"
                       Text="{Loc 'frontier-lobby-station-title'}"
                       StyleClasses="FancyWindowTitle" />
            </Button>
            <!-- Commented by LuaM
            <Button Name="CrewTabButton"
                    MinSize="180 40"
                    StyleClasses="ButtonSquare"
                    HorizontalExpand="True">
                <Label Name="CrewTabLabel"
                       Text="{Loc 'frontier-lobby-crew-title'}"
                       StyleClasses="FancyWindowTitle" />
            </Button>
            -->
        </BoxContainer>
            </PanelContainer>
        </PanelContainer>
        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer Name="ContentContainer" VerticalExpand="True" HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#07090AFF"
                                           BorderColor="#3D484D"
                                           BorderThickness="1 1 1 1" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
        </PanelContainer>
    </BoxContainer>

</controls:FancyWindow>
