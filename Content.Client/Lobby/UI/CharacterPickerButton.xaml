<!-- LuaM -->
<ContainerButton xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:style="clr-namespace:Content.Client.Stylesheets"
         xmlns:hud="clr-namespace:Content.Client._LuaM.UserInterface.Hud">
    <BoxContainer Orientation="Horizontal"
                  HorizontalExpand="True"
                  SeparationOverride="8"
                  Margin="8 4 10 4"
                  Name="InternalHBox">
        <SpriteView Scale="2 2"
                    OverrideDirection="South"
                    Name="View"
                    SetSize="64 64"/>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
            <Label Name="CodeLabel" StyleClasses="LuaMHudHeading" />
            <Label Name="DescriptionLabel"
                   ClipText="True"
                   HorizontalExpand="True"
                   StyleClasses="LuaMHudBody"/>
        </BoxContainer>
        <BoxContainer Orientation="Vertical" VerticalAlignment="Center" SeparationOverride="4">
            <hud:HudRing Name="Ring" HorizontalAlignment="Center" Visible="False" />
            <Button Name="DeleteButton"
                    StyleClasses="LuaMHudDanger"
                    Text="{Loc 'character-setup-gui-character-picker-button-delete-button'}"/>
            <Button Name="ConfirmDeleteButton"
                    StyleClasses="LuaMHudDanger"
                    Text="{Loc 'character-setup-gui-character-picker-button-confirm-delete-button'}"
                    Visible="False"/>
        </BoxContainer>
    </BoxContainer>
</ContainerButton>
