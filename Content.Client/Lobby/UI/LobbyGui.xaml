<!-- LuaM -->
<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:luamLobby="clr-namespace:Content.Client._LuaM.Lobby"
    xmlns:hud="clr-namespace:Content.Client._LuaM.UserInterface.Hud">
    <!-- Background -->
    <luamLobby:LobbyBackgroundControl Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                                      Stretch="KeepAspectCovered" />
    <hud:HudVignette Name="Vignette" />
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="16 16 16 16">
        <hud:HudStyleScope />
        <BoxContainer Name="LeftSide" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <Control Name="DefaultState" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" SetWidth="372" SeparationOverride="12">
                    <PanelContainer StyleClasses="LuaMHudWindow">
                        <BoxContainer Orientation="Vertical" SeparationOverride="10">
                            <hud:HudHeader Id="SYS-00" Title="{Loc 'lobby-hud-system'}" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                <Button Name="LeaveButton" Access="Public" StyleClasses="LuaMHudPower" SetSize="42 42"
                                        ToolTip="{Loc 'lobby-hud-leave'}">
                                    <hud:HudIcon Name="LeaveIcon" Kind="Power" SetSize="22 22" />
                                </Button>
                                <Control HorizontalExpand="True" />
                                <vote:VoteCallMenuButton Name="CallVoteButton" StyleClasses="LuaMHudIcon" SetSize="42 42"
                                                         ToolTip="{Loc 'lobby-hud-vote'}">
                                    <hud:HudIcon Kind="Vote" SetSize="22 22" />
                                </vote:VoteCallMenuButton>
                                <Button Name="GuideButton" StyleClasses="LuaMHudIcon" SetSize="42 42"
                                        ToolTip="{Loc 'server-info-guidebook-button'}">
                                    <hud:HudIcon Kind="Book" SetSize="22 22" />
                                </Button>
                                <Button Name="RulesButton" StyleClasses="LuaMHudIcon" SetSize="42 42"
                                        ToolTip="{Loc 'server-info-rules-button'}">
                                    <hud:HudIcon Kind="Rules" SetSize="22 22" />
                                </Button>
                                <Button Name="AHelpButton" Access="Public" StyleClasses="LuaMHudIcon" SetSize="42 42"
                                        ToolTip="{Loc 'lobby-hud-help'}">
                                    <hud:HudIcon Kind="Help" SetSize="22 22" />
                                </Button>
                                <Button Name="OptionsButton" Access="Public" StyleClasses="LuaMHudIcon" SetSize="42 42"
                                        ToolTip="{Loc 'lobby-hud-options'}">
                                    <hud:HudIcon Kind="Gear" SetSize="22 22" />
                                </Button>
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="DeployWindow" StyleClasses="LuaMHudWindow">
                        <BoxContainer Orientation="Vertical" SeparationOverride="8">
                            <hud:HudHeader Name="DeployHeader" Id="DPL-01" Title="{Loc 'lobby-hud-deploy-short'}" />
                            <PanelContainer Name="TimerBox" SetHeight="150">
                                <PanelContainer.PanelOverride>
                                    <hud:StyleBoxGrid Step="0" BackgroundColor="#1A1F22" BorderColor="#3F6E8A" ScanlineColor="#5FA8D30F"
                                                      ContentMarginLeftOverride="12" ContentMarginRightOverride="12"
                                                      ContentMarginTopOverride="8" ContentMarginBottomOverride="8" />
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Vertical">
                                    <BoxContainer Orientation="Horizontal">
                                        <Label Name="StartTime" Access="Public" StyleClasses="LuaMHudLabel" FontColorOverride="#5FA8D3" HorizontalExpand="True" ClipText="True" />
                                    </BoxContainer>
                                    <Label Name="RoundTimer" Access="Public" StyleClasses="LuaMHudBigBold" FontColorOverride="#5FA8D3" Align="Left" VerticalExpand="True" VAlign="Center" />
                                    <Label Name="StationTime" Access="Public" StyleClasses="LuaMHudMark" ClipText="True" />
                                </BoxContainer>
                            </PanelContainer>
                            <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                    Text="{Loc 'ui-lobby-ready-up-button'}"
                                    StyleClasses="LuaMHudReady" MinHeight="64" />
                            <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                Text="{Loc 'ui-lobby-observe-button'}"
                                                StyleClasses="LuaMHudButton" MinHeight="34"
                                                WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer" Access="Public" />
                </BoxContainer>

                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" SeparationOverride="8">
                    <info:DevInfoBanner Name="DevInfoBanner" VerticalExpand="False" />
                    <PanelContainer StyleClasses="LuaMHudPanel">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Button Name="PreviousSongButton" Access="Public" StyleClasses="LuaMHudButton" Text="&lt;" MinSize="28 28"
                                    ToolTip="{Loc 'ui-lobby-song-previous'}" />
                            <Button Name="PauseSongButton" Access="Public" StyleClasses="LuaMHudButton" MinSize="28 28"
                                    ToolTip="{Loc 'ui-lobby-song-pause'}">
                                <TextureRect Name="PauseSongIcon" Access="Public" SetSize="16 16"
                                             TexturePath="/Textures/Interface/AdminActions/pause.png"
                                             Stretch="KeepAspectCentered"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <RichTextLabel Name="LobbySong" Access="Public" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6 0" />
                            <Button Name="NextSongButton" Access="Public" StyleClasses="LuaMHudButton" Text="&gt;" MinSize="28 28"
                                    ToolTip="{Loc 'ui-lobby-song-next'}" />
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer StyleClasses="LuaMHudPanel" Name="BackgroundSwitcher" Access="Public">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                            <Button Name="PreviousBackgroundButton" Access="Public" StyleClasses="LuaMHudButton" Text="&lt;" MinSize="28 28" />
                            <Label Text="{Loc 'ui-lobby-background-label'}" VAlign="Center" StyleClasses="LuaMHudLabel" Margin="4 0" />
                            <Button Name="NextBackgroundButton" Access="Public" StyleClasses="LuaMHudButton" Text="&gt;" MinSize="28 28" />
                        </BoxContainer>
                    </PanelContainer>
                    <!-- LuaM -->
                    <Button Name="RoadmapButton" Text="{Loc 'lobby-roadmap-button'}" />
                </BoxContainer>

                <PanelContainer Name="RightSide" Access="Public" StyleClasses="LuaMHudWindow" HorizontalAlignment="Right"
                                VerticalExpand="True" SetWidth="620">
                    <BoxContainer Orientation="Vertical" SeparationOverride="10">
                        <hud:HudHeader Id="TRM-01" Title="{Loc 'lobby-hud-terminal-window'}" />
                        <BoxContainer Name="HeaderContainer" Access="Public" Orientation="Vertical" SeparationOverride="6">
                            <Label Name="ServerName" Access="Public" StyleClasses="LuaMHudTitle" ClipText="True" />
                            <info:LinkBanner Name="LinkBanner" VerticalExpand="False" HorizontalAlignment="Left" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <hud:HudShape Status="Advisory" SetSize="9 9" />
                            <Label Text="{Loc 'lobby-hud-character'}" StyleClasses="LuaMHudHeading" VAlign="Center" />
                            <PanelContainer HorizontalExpand="True" MinHeight="1" VerticalAlignment="Center">
                                <PanelContainer.PanelOverride><graphics:StyleBoxFlat BackgroundColor="#1A1F22" /></PanelContainer.PanelOverride>
                            </PanelContainer>
                        </BoxContainer>
                        <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />

                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <hud:HudShape Status="Advisory" SetSize="9 9" />
                            <Label Text="{Loc 'lobby-hud-round'}" StyleClasses="LuaMHudHeading" VAlign="Center" />
                            <PanelContainer HorizontalExpand="True" MinHeight="1" VerticalAlignment="Center">
                                <PanelContainer.PanelOverride><graphics:StyleBoxFlat BackgroundColor="#1A1F22" /></PanelContainer.PanelOverride>
                            </PanelContainer>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="12">
                            <PanelContainer Name="NewsBox" HorizontalExpand="True" SetHeight="124">
                                <PanelContainer.PanelOverride>
                                    <hud:StyleBoxGrid Step="0" ContentMarginLeftOverride="10" ContentMarginRightOverride="4"
                                                      ContentMarginTopOverride="6" ContentMarginBottomOverride="6" />
                                </PanelContainer.PanelOverride>
                                <ScrollContainer HScrollEnabled="False">
                                    <info:ServerInfo Name="ServerInfo" Access="Public" VerticalExpand="False" Margin="0 0 6 0" />
                                </ScrollContainer>
                            </PanelContainer>
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <hud:HudShape Status="Advisory" SetSize="9 9" />
                            <Label Text="{Loc 'lobby-hud-terminal'}" StyleClasses="LuaMHudHeading" VAlign="Center" />
                            <PanelContainer HorizontalExpand="True" MinHeight="1" VerticalAlignment="Center">
                                <PanelContainer.PanelOverride><graphics:StyleBoxFlat BackgroundColor="#1A1F22" /></PanelContainer.PanelOverride>
                            </PanelContainer>
                        </BoxContainer>
                        <PanelContainer VerticalExpand="True">
                            <PanelContainer.PanelOverride>
                                <hud:StyleBoxGrid Step="0" ContentMarginLeftOverride="4" ContentMarginRightOverride="4"
                                                  ContentMarginTopOverride="4" ContentMarginBottomOverride="4" />
                            </PanelContainer.PanelOverride>
                            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" MinHeight="225" />
                        </PanelContainer>
                    </BoxContainer>
                </PanelContainer>
            </Control>
            <!-- Character setup state -->
            <!-- This is injected on startup. Funky! -->
            <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
