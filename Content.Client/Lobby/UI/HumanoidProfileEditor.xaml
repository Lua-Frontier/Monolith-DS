<!-- LuaM -->
<BoxContainer xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
         xmlns:hud="clr-namespace:Content.Client._LuaM.UserInterface.Hud"
         HorizontalExpand="True" Orientation="Vertical" SeparationOverride="12">
    <BoxContainer Name="TabStripSlot" Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 206 0" />
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="16">
    <!-- Left side -->
    <PanelContainer Name="EditorWindow" StyleClasses="LuaMHudWindow" VerticalExpand="True">
    <BoxContainer Orientation="Vertical" SeparationOverride="6">
        <hud:HudHeader Name="EditorHeader" Id="CHR-01" Title="{Loc 'character-setup-gui-window'}" />
        <BoxContainer Name="CharacterHeaderSlot" Orientation="Vertical" Margin="0 4 0 0" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
            <LineEdit Name="NameEdit" HorizontalExpand="True" VerticalAlignment="Center" />
            <Button Name="NameRandomize" StyleClasses="LuaMHudIcon" SetSize="32 32"
                    ToolTip="{Loc 'humanoid-profile-editor-name-random-tooltip'}">
                <hud:HudIcon Kind="Dice" SetSize="20 20" />
            </Button>
            <Button Name="RandomizeEverythingButton"
                    Text="{Loc 'humanoid-profile-editor-randomize-everything-button'}" />
        </BoxContainer>
        <RichTextLabel Name="WarningLabel" />
        <!-- tabContainer -->
        <TabContainer Name="TabContainer" VerticalExpand="True">
            <BoxContainer Orientation="Vertical">
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <!-- appearanceList -->
                    <BoxContainer Orientation="Vertical" Margin="0 0 8 0" SeparationOverride="10">
                        <PanelContainer StyleClasses="LuaMHudWindow">
                        <BoxContainer Orientation="Vertical">
                        <hud:HudHeader Id="BSC-01" Title="{Loc 'humanoid-profile-editor-section-basic'}" />
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="0 8 0 0">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="16">
                            <!-- Species -->
                            <BoxContainer HorizontalExpand="True">
                                <Label Text="{Loc 'humanoid-profile-editor-species-label'}" />
                                <Control HorizontalExpand="True" />
                                <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3"
                                               VerticalAlignment="Center"
                                               ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}" />
                                <OptionButton Name="SpeciesButton" HorizontalAlignment="Right" />
                            </BoxContainer>
                            <!-- Age -->
                            <BoxContainer HorizontalExpand="True">
                                <Label Text="{Loc 'humanoid-profile-editor-age-label'}" />
                                <Control HorizontalExpand="True" />
                                <LineEdit Name="AgeEdit" MinSize="48 0" HorizontalAlignment="Right" />
                            </BoxContainer>
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="16">
                            <!-- Sex -->
                            <BoxContainer HorizontalExpand="True">
                                <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" />
                                <Control HorizontalExpand="True" />
                                <OptionButton Name="SexButton" HorizontalAlignment="Right" />
                            </BoxContainer>
                            <!-- Pronouns -->
                            <BoxContainer HorizontalExpand="True">
                                <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" />
                                <Control HorizontalExpand="True" />
                                <OptionButton Name="PronounsButton" HorizontalAlignment="Right" />
                            </BoxContainer>
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="16">
                            <!-- Spawn Priority -->
                            <BoxContainer HorizontalExpand="True">
                                <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" />
                                <Control HorizontalExpand="True" />
                                <OptionButton Name="SpawnPriorityButton" HorizontalAlignment="Right" />
                            </BoxContainer>
                            <!-- TTS Voice -->
                            <BoxContainer HorizontalExpand="True" Visible="False" Name="TTSContainer">
                                <Label Text="{Loc 'humanoid-profile-editor-voice-label'}" />
                                <Control HorizontalExpand="True"/>
                                <OptionButton Name="VoiceButton" HorizontalAlignment="Right" />
                                <Button Name="VoicePlayButton" Text="{Loc 'humanoid-profile-editor-voice-play'}" HorizontalAlignment="Right" />
                            </BoxContainer>
                            </BoxContainer>
                        </BoxContainer>
                        </BoxContainer>
                        </PanelContainer>
                        <PanelContainer Name="ColorsWindow" StyleClasses="LuaMHudWindow">
                        <BoxContainer Name="ColorsBox" Orientation="Vertical" SeparationOverride="6">
                            <hud:HudHeader Id="CLR-02" Title="{Loc 'humanoid-profile-editor-section-colors'}" />
                            <Control Margin="0 2 0 0" />
                            <Slider HorizontalExpand="True" Name="Skin" MinValue="0" MaxValue="100" Value="20" />
                            <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True" />
                            <humanoid:EyeColorPicker Name="EyeColorPicker" />
                        </BoxContainer>
                        </PanelContainer>
                        <!-- Hair -->
                        <PanelContainer Name="HairPanel" StyleClasses="LuaMHudWindow">
                        <BoxContainer Orientation="Vertical">
                            <hud:HudHeader Id="HAR-03" Title="{Loc 'humanoid-profile-editor-section-hair'}" />
                            <BoxContainer Orientation="Horizontal" Margin="0 6 0 0" SeparationOverride="16">
                                <humanoid:SingleMarkingPicker Name="HairStylePicker" Category="Hair" />
                                <humanoid:SingleMarkingPicker Name="FacialHairPicker" Category="FacialHair" />
                            </BoxContainer>
                        </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical">
                <!-- Jobs -->
                <OptionButton Name="PreferenceUnavailableButton" />
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="JobList" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
            <!-- Frontier: no Antags tab
            <BoxContainer Orientation="Vertical" Margin="10">
                <! - - Antags  - - >
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="AntagList" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
            End Frontier -->
            <BoxContainer Orientation="Vertical">
                <!-- Traits -->
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="TraitsList" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
            <!-- Monolith: Company Tab -->
            <BoxContainer Orientation="Vertical">
                <PanelContainer StyleClasses="LuaMHudWindow" VerticalExpand="True">
                <BoxContainer Orientation="Vertical">
                <hud:HudHeader Id="CMP-05" Title="{Loc 'humanoid-profile-editor-section-company'}" />
                <!-- Company -->
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <!-- Select -->
                    <BoxContainer Orientation="Vertical">
                        <BoxContainer Margin="0 8" Orientation="Horizontal" HorizontalExpand="True">
                            <Label Text="{Loc 'humanoid-profile-editor-company-label'}" />
                            <Control HorizontalExpand="True" />
                            <OptionButton Name="CompanyButton" HorizontalAlignment="Right" />
                        </BoxContainer>
                        <!-- Description -->
                        <RichTextLabel Name="CompanyDescriptionLabel"
                                       VerticalAlignment="Top"
                                       HorizontalExpand="True"
                                       Margin="2 4" />
                        <!-- Company Image -->
                        <TextureRect Name="CompanyImage" HorizontalAlignment="Center"
                                     Stretch="KeepAspectCentered"
                                     SetSize="360 290" Margin="0 8"
                                     Visible="False" />
                    </BoxContainer>
                </ScrollContainer>
                </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <BoxContainer Name="MarkingsTab" Orientation="Vertical">
                <PanelContainer StyleClasses="LuaMHudWindow" VerticalExpand="True">
                <BoxContainer Orientation="Vertical">
                <hud:HudHeader Id="MRK-06" Title="{Loc 'humanoid-profile-editor-section-markings'}" />
                <!-- Markings -->
                <humanoid:MarkingPicker Name="Markings" IgnoreCategories="Hair,FacialHair" VerticalExpand="True" Margin="0 6 0 0" />
                </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </TabContainer>
        <BoxContainer Name="ProfileHighlight" Orientation="Horizontal" SeparationOverride="6">
            <Button Name="FileMenuButton" StyleClasses="LuaMHudIcon" SetSize="34 34" ToggleMode="True"
                    ToolTip="{Loc 'character-setup-gui-file-menu'}">
                <hud:HudIcon Kind="More" SetSize="20 20" />
            </Button>
            <BoxContainer Name="FileMenu" Orientation="Horizontal" SeparationOverride="4" Visible="False">
                <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" />
                <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" />
                <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" />
                <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" />
            </BoxContainer>
            <Control HorizontalExpand="True" />
            <Button Name="ResetButton" Disabled="True" Text="{Loc 'humanoid-profile-editor-reset-button'}" />
            <Button Name="SaveButton" Text="{Loc 'humanoid-profile-editor-save-button'}" MinWidth="140" />
        </BoxContainer>
    </BoxContainer>
    </PanelContainer>

    <BoxContainer Name="PreviewPanel" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="12">
        <PanelContainer StyleClasses="LuaMHudWindow" HorizontalAlignment="Stretch" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" SeparationOverride="8">
            <hud:HudHeader Name="PreviewHeader" Id="CHR-02" Title="{Loc 'character-setup-gui-preview'}" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="10" Margin="0 4 0 0" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <Label Text="{Loc 'humanoid-profile-editor-height-short'}" StyleClasses="LuaMHudMonoDim" HorizontalAlignment="Center" />
                    <hud:HudVerticalSlider Name="HeightSlider" MinValue="0.8" MaxValue="1.2" Value="1.0"
                                           VerticalExpand="True" HorizontalAlignment="Center" />
                    <Label Name="HeightLabel" Text="100" StyleClasses="LuaMHudMono" HorizontalAlignment="Center" />
                </BoxContainer>
                <PanelContainer Name="SpriteBox" HorizontalExpand="True" VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <hud:StyleBoxGrid />
                    </PanelContainer.PanelOverride>
                    <SpriteView Name="SpriteView" Scale="14 14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </PanelContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Label Text="{Loc 'humanoid-profile-editor-width-short'}" StyleClasses="LuaMHudMonoDim" VAlign="Center" MinWidth="58" />
                <hud:HudVerticalSlider Name="WidthSlider" Horizontal="True" MinValue="0.8" MaxValue="1.2" Value="1.0" HorizontalExpand="True" VerticalAlignment="Center" />
                <Label Name="WidthLabel" Text="100" StyleClasses="LuaMHudMono" VAlign="Center" MinWidth="110" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalAlignment="Center">
                <Button Name="SpriteRotateLeft" StyleClasses="LuaMHudIcon" SetSize="34 34"
                        ToolTip="{Loc 'humanoid-profile-editor-rotate-tooltip'}">
                    <hud:HudIcon Kind="RotateLeft" SetSize="20 20" />
                </Button>
                <Button Name="SpriteRotateRight" StyleClasses="LuaMHudIcon" SetSize="34 34"
                        ToolTip="{Loc 'humanoid-profile-editor-rotate-tooltip'}">
                    <hud:HudIcon Kind="RotateRight" SetSize="20 20" />
                </Button>
                <Button Name="ShowClothes" Pressed="True" ToggleMode="True" StyleClasses="LuaMHudIcon" SetSize="34 34"
                        ToolTip="{Loc 'humanoid-profile-editor-clothes-tooltip'}">
                    <hud:HudIcon Kind="Shirt" SetSize="20 20" />
                </Button>
                <Button Name="HeightResetButton" Text="{Loc 'humanoid-profile-editor-size-reset'}" SetHeight="34" />
                <Button Name="WidthResetButton" Visible="False" />
            </BoxContainer>
        </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    </BoxContainer>
</BoxContainer>
