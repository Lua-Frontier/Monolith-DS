<PanelContainer xmlns="https://spacestation14.io"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              Margin="5 5 5 5" HorizontalExpand="True">
    <PanelContainer.PanelOverride>
        <gfx:StyleBoxFlat BorderThickness="1" BorderColor="#777777"/>
    </PanelContainer.PanelOverride>

    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
        <PanelContainer HorizontalExpand="True">
            <!-- LuaM: expanding names wrap within the recipe card. -->
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <BoxContainer Name="IconContainer"/>
                <RichTextLabel Name="ResultName" HorizontalExpand="True" VerticalAlignment="Center"/>
            </BoxContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#393c3f"/>
            </PanelContainer.PanelOverride>
        </PanelContainer>

        <!-- LuaM: full-width ingredient rows, followed by cooking info; no competing side column. -->
        <BoxContainer Orientation="Vertical" Margin="10" HorizontalExpand="True" SeparationOverride="6">
            <RichTextLabel HorizontalExpand="True" Text="{Loc 'guidebook-microwave-ingredients-header'}"/>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Name="IngredientsList" SeparationOverride="2"/>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 6 0 0">
                <RichTextLabel HorizontalExpand="True" Text="{Loc 'guidebook-microwave-cook-time-header'}"/>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                    <WrapContainer Name="Machines"/><!-- Frontier: show entities that can cook a recipe. -->
                    <RichTextLabel Name="CookTimeLabel" HorizontalExpand="True" VerticalAlignment="Center"/>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Margin="10" HorizontalExpand="True">
            <RichTextLabel Name="ResultDescription" HorizontalExpand="True"/>
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
