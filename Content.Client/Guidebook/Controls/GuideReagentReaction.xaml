<BoxContainer xmlns="https://spacestation14.io"
              Orientation="Horizontal"
              HorizontalAlignment="Stretch"
              HorizontalExpand="True"
              Margin="0 0 0 5">
    <!-- LuaM: all three columns share the available width; their text wraps. -->
    <!-- Lua: one link per reagent instead of a single label -->
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
        <BoxContainer Name="ReactantsContainer" HorizontalExpand="True" VerticalAlignment="Center" Orientation="Vertical">
            <!-- Reactants will be added as children here -->
        </BoxContainer>
    </BoxContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
        <TextureRect TexturePath="/Textures/Interface/Misc/beakerlarge.png"
                     HorizontalAlignment="Center"
                     Name="MixTexture"
                     Access="Public"/>
        <RichTextLabel Name="MixLabel"
                       HorizontalExpand="True"
                       Access="Public"
                       Margin="2 0 0 0"/>
    </BoxContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
        <BoxContainer Name="ProductsContainer" HorizontalExpand="True" VerticalAlignment="Center" Orientation="Vertical">
            <!-- Products will be added as children here -->
        </BoxContainer>
    </BoxContainer>
</BoxContainer>
