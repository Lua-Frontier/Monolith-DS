<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client._LuaM.RpPanel.RpPanelWindow"
               HeaderClass="DS14MenuHeader"
               TitleClass="DS14MenuTitle"
               Title="{Loc rp-panel-title}"
               MinSize="520 560"
               SetSize="560 700">
    <PanelContainer StyleClasses="DS14MenuShell" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
            <PanelContainer StyleClasses="RpPanelSection" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" Margin="10 8" SeparationOverride="10">
                    <PanelContainer StyleClasses="RpPanelIconFrame" SetSize="48 48" VerticalAlignment="Center">
                        <SpriteView Name="TargetView"
                                    SetSize="44 44"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                        <Label Text="{Loc rp-panel-target-label}" StyleClasses="RpPanelMuted"/>
                        <Label Name="HeaderLabel"
                               StyleClasses="DS14MenuTitle"
                               ClipText="True"
                               HorizontalExpand="True"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <LineEdit Name="SearchInput"
                          StyleClasses="DS14MenuInput"
                          HorizontalExpand="True"
                          PlaceHolder="{Loc rp-panel-search-placeholder}"/>
                <Button Name="ClearSearchButton"
                        StyleClasses="DS14MenuProfileControl"
                        SetSize="30 30"
                        ToolTip="{Loc rp-panel-search-clear-tooltip}">
                    <TextureRect TexturePath="/Textures/Interface/VerbIcons/close.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 SetSize="14 14"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 MouseFilter="Ignore"/>
                </Button>
            </BoxContainer>

            <Label Name="ResultsLabel"
                   StyleClasses="RpPanelMuted"
                   HorizontalAlignment="Center"/>

            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Button Name="CreateEmoteButton"
                        StyleClasses="DS14MenuProfileControl"
                        HorizontalExpand="True"
                        Text="{Loc rp-panel-custom-create}"/>
                <Button Name="ExpandAllButton"
                        StyleClasses="DS14MenuProfileControl"
                        HorizontalExpand="True"
                        Text="{Loc rp-panel-expand-all}"/>
                <Button Name="CollapseAllButton"
                        StyleClasses="DS14MenuProfileControl"
                        HorizontalExpand="True"
                        Text="{Loc rp-panel-collapse-all}"/>
            </BoxContainer>

            <PanelContainer StyleClasses="RpPanelList" HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6">
                    <ScrollContainer Name="InteractionScroll"
                                     HScrollEnabled="False"
                                     HorizontalExpand="True"
                                     VerticalExpand="True">
                        <BoxContainer Name="ButtonsContainer"
                                      Orientation="Vertical"
                                      SeparationOverride="6"/>
                    </ScrollContainer>

                    <BoxContainer Name="EmptyStateContainer"
                                  Orientation="Vertical"
                                  Visible="False"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SeparationOverride="8">
                        <TextureRect TexturePath="/Textures/Interface/VerbIcons/examine.svg.192dpi.png"
                                     Stretch="KeepAspectCentered"
                                     SetSize="34 34"
                                     HorizontalAlignment="Center"
                                     Modulate="#7A8590"/>
                        <Label Name="EmptyStateLabel"
                               StyleClasses="RpPanelMuted"
                               HorizontalAlignment="Center"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" SeparationOverride="12" MinHeight="32">
                <CheckBox Name="PrivateModeToggle"
                          Text="{Loc rp-panel-private-mode-label}"
                          ToolTip="{Loc rp-panel-private-mode-tooltip}"/>
                <CheckBox Name="LungeToggle"
                          Text="{Loc rp-panel-lunge-label}"
                          ToolTip="{Loc rp-panel-lunge-tooltip}"/>
                <Control HorizontalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
