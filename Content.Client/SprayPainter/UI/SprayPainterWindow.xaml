<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:luam="clr-namespace:Content.Client._LuaM.SprayPainter"
               MinSize="520 300"
               SetSize="520 700"
               Title="{Loc 'spray-painter-window-title'}">
    <!-- LuaM: tabs for decal painting -->
    <TabContainer Name="Tabs">
        <BoxContainer Name="StylesTab"
                      Orientation="Horizontal"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      SeparationOverride="4"
                      MinWidth="450">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SeparationOverride="4"
                          MinWidth="200">
                <Label Name="SelectedSpriteLabel"
                       Text="{Loc 'spray-painter-selected-style'}">
                </Label>
                <ItemList Name="SpriteList"
                          SizeFlagsStretchRatio="8"
                          VerticalExpand="True"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SeparationOverride="4"
                          MinWidth="200">
                <Label Name="SelectedColorLabel"
                       Text="{Loc 'spray-painter-selected-color'}"/>
                <ItemList Name="ColorList"
                          SizeFlagsStretchRatio="8"
                          VerticalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
        <luam:SprayPainterDecalsControl Name="DecalsTab" />
    </TabContainer>
</DefaultWindow>
