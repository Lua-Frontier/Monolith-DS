<controls:ActionPageButtons
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Systems.Actions.Controls"
    HorizontalAlignment="Left">
    <BoxContainer Orientation="Horizontal" SeparationOverride="10" Margin="8 2 0 0">
        <TextureButton TexturePath="left_arrow.svg.192dpi"
                       Scale="0.5 0.5"
                       VerticalAlignment="Center"
                       Name="LeftArrow"
                       Access="Public"/>
        <Label Text="1" VerticalAlignment="Center" Name="Label" Access="Public" />
        <TextureButton TexturePath="right_arrow.svg.192dpi"
                       Scale="0.5 0.5"
                       VerticalAlignment="Center"
                       Name="RightArrow"
                       Access="Public"/>
    </BoxContainer>
</controls:ActionPageButtons>
