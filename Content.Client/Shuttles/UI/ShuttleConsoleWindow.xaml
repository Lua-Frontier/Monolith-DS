<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
                      Title="{Loc 'shuttle-console-window-title'}"
                      SetSize="1260 870"
                      MinSize="1260 870">
    <!-- Lua: 1260x850 instead of 1300x994, the radars scale with the window -->
    <!-- LuaM: Dead Space 14 menu look like the AHelp, the window shell and header are set in code -->
    <!-- LuaM: 850 > 870 for the hints line -->

    <BoxContainer Orientation="Vertical" Margin="8 6 8 8">
        <!-- Top row mode buttons -->
        <PanelContainer StyleClasses="LuaMConsoleSection" HorizontalExpand="True">
            <BoxContainer Name="ModeButtons"
                          Orientation="Horizontal"
                          HorizontalAlignment="Stretch"
                          HorizontalExpand="True"
                          MinSize="44 44"
                          SeparationOverride="4"
                          Margin="4">
                <Button Name="NavModeButton"
                        ToggleMode="True"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        Text="NAV"
                        StyleClasses="LuaMConsoleButton"/>
                <Button Name="MapModeButton"
                        ToggleMode="True"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        Text="MAP"
                        StyleClasses="LuaMConsoleButton"/>
                <Button Name="DockModeButton"
                        ToggleMode="True"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        Text="DOCK"
                        StyleClasses="LuaMConsoleButton"/>
            </BoxContainer>
        </PanelContainer>
        <!-- Contents box -->
        <BoxContainer Name="Contents"
                      HorizontalAlignment="Stretch"
                      VerticalExpand="True"
                      Margin="0 6 0 0">
            <ui:NavScreen Name="NavContainer" Visible="False"/>
            <ui:MapScreen Name="MapContainer" Visible="False"/>
            <ui:DockingScreen Name="DockContainer" Visible="False"/>
        </BoxContainer>
        <!-- LuaM -->
        <Label Name="HintsLabel"
               StyleClasses="LabelSubText"
               HorizontalAlignment="Center"
               Margin="0 4 0 0"/>
    </BoxContainer>
</controls:FancyWindow>
