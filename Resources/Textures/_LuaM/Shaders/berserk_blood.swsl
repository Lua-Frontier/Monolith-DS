// Screen effect of the berserk heart: the view is washed in red and blood creeps in from the edges,
// pulsing with a heartbeat. intensity goes from about 0.6 (heart on) to 1.0 (frenzy).
uniform sampler2D SCREEN_TEXTURE;
uniform highp float intensity;

highp float hash2(highp vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

highp float noise(highp vec2 p)
{
    highp vec2 i = floor(p);
    highp vec2 f = fract(p);
    highp vec2 u = f * f * (3.0 - 2.0 * f);

    highp float a = hash2(i);
    highp float b = hash2(i + vec2(1.0, 0.0));
    highp float c = hash2(i + vec2(0.0, 1.0));
    highp float d = hash2(i + vec2(1.0, 1.0));

    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

highp float fbm(highp vec2 p)
{
    highp float value = 0.0;
    highp float amp = 0.5;
    for (int k = 0; k < 4; k++)
    {
        value += amp * noise(p);
        p *= 2.03;
        amp *= 0.5;
    }

    return value;
}

void fragment()
{
    highp vec2 uv = UV;
    highp float t = TIME;
    highp float i = intensity;

    highp vec3 base = texture2D(SCREEN_TEXTURE, uv).rgb;

    // Heartbeat: two quick thumps, then a pause.
    highp float beat = fract(t * 1.3);
    highp float thump = exp(-beat * 9.0) + 0.6 * exp(-abs(beat - 0.28) * 14.0);

    // Distance to the nearest edge, the sides count as further away so the blood there is thinner.
    highp vec2 e = min(uv, 1.0 - uv);
    highp float dEdge = min(e.x * 1.4, e.y);

    // Ragged border that slowly shifts, with vertical runs like blood streaking down glass.
    highp float rag = fbm(uv * vec2(6.0, 4.0) + vec2(0.0, t * 0.03));
    highp float streak = noise(vec2(uv.x * 60.0, uv.y * 2.5 + 3.7));
    streak *= streak;

    highp float reach = 0.10 + 0.10 * i + 0.02 * thump;
    highp float depth = reach * (0.55 + 0.9 * rag) + 0.10 * i * streak;
    highp float blood = 1.0 - smoothstep(depth * 0.55, depth, dEdge);

    // Thicker and darker towards the very edge, with a few wet highlights.
    highp float thick = 1.0 - smoothstep(0.0, depth, dEdge);
    highp vec3 bloodColor = mix(vec3(0.55, 0.02, 0.03), vec3(0.16, 0.0, 0.01), thick);
    highp float wet = smoothstep(0.72, 0.9, fbm(uv * vec2(22.0, 14.0)));
    bloodColor += vec3(0.25, 0.05, 0.05) * wet * 0.5;

    // The whole view goes red, harder on every thump.
    highp float lum = dot(base, vec3(0.299, 0.587, 0.114));
    highp vec3 tinted = mix(base, vec3(lum * 1.15, lum * 0.18, lum * 0.16), (0.35 + 0.08 * thump) * i);

    // Soft red haze towards the corners.
    highp float vig = smoothstep(0.25, 0.75, length(uv - vec2(0.5)));
    tinted = mix(tinted, vec3(0.45, 0.0, 0.02), vig * (0.30 + 0.15 * thump) * i);

    highp vec3 color = mix(tinted, bloodColor, blood * 0.92);
    COLOR = vec4(clamp(color, 0.0, 1.0), 1.0);
}
