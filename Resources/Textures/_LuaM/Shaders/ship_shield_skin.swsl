light_mode unshaded;

uniform highp float progress;
uniform highp vec4 skin_color;
uniform highp float brightness;
uniform highp float pixel_grid;
uniform highp float hex_density;
uniform highp vec2 form_origin;
uniform highp float fill_level;
uniform highp float line_level;
uniform highp float rim_level;
uniform highp float shard_scale;
uniform highp float breath_depth;
uniform highp vec2 half_size;
uniform highp float edge_depth;
uniform lowp int impact_count;
uniform highp vec2[8] impact_pos;
uniform highp float[8] impact_age;
uniform highp float[8] impact_strength;

const highp float FEATHER = 0.15;
const highp float IMPACT_LIFETIME = 2.5;
const highp float WAVE_SPEED = 18.0;

highp float hash21(highp vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

highp float vnoise(highp vec2 p) {
    highp vec2 i = floor(p);
    highp vec2 f = fract(p);
    highp float a = hash21(i);
    highp float b = hash21(i + vec2(1.0, 0.0));
    highp float c = hash21(i + vec2(0.0, 1.0));
    highp float d = hash21(i + vec2(1.0, 1.0));
    highp vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

highp float hexDist(highp vec2 p) {
    p = abs(p);
    return max(dot(p, vec2(0.5, 0.866025)), p.x);
}

highp float crackDistance(highp vec2 p) {
    highp vec2 cell = floor(p);
    highp vec2 local = fract(p);
    highp float nearest = 8.0;
    highp float second = 8.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            highp vec2 offset = vec2(float(x), float(y));
            highp vec2 seed = cell + offset;
            highp vec2 point = vec2(hash21(seed), hash21(seed + vec2(19.7, 43.1)));
            highp float d = length(offset + 0.2 + point * 0.6 - local);
            second = min(second, max(nearest, d));
            nearest = min(nearest, d);
        }
    }
    return second - nearest;
}

highp vec2 hexCell(highp vec2 uv) {
    highp vec2 r = vec2(1.0, 1.732051);
    highp vec2 h = r * 0.5;
    highp vec2 a = mod(uv, r) - h;
    highp vec2 b = mod(uv - h, r) - h;
    highp float useB = step(dot(b, b), dot(a, a));
    highp vec2 gv = mix(a, b, useB);
    highp vec2 id = floor((uv - gv) / h + vec2(0.5));
    return vec2(hexDist(gv), hash21(id));
}

// -- Расстояние до границы овала в тайлах, внутри положительное
highp float borderDepth(highp vec2 p, highp float r) {
    highp vec2 halfSize = max(half_size, vec2(0.01));
    if (r < 0.0001)
        return min(halfSize.x, halfSize.y);
    return (1.0 - r) * r / max(length(p / halfSize), 0.0001);
}

// -- Ярко у границы, плечо на трети глубины, плавный спад до нуля к концу полосы
highp float bandGlow(highp float depth, highp float band) {
    if (depth <= 0.0)
        return clamp((depth + FEATHER) / FEATHER, 0.0, 1.0);
    highp float shoulder = band * 0.3;
    if (depth <= shoulder)
        return mix(1.0, 0.45, depth / shoulder);
    return 0.45 * (1.0 - smoothstep(shoulder, band, depth));
}

void fragment() {
    highp vec2 uvq = UV2;
    if (pixel_grid > 1.0)
        uvq = (floor(UV2 * pixel_grid) + vec2(0.5)) / pixel_grid;

    highp vec2 p = (uvq - vec2(0.5)) * 2.0;
    highp float r = length(p);
    highp vec2 world = p * half_size;

    highp float minHalf = min(half_size.x, half_size.y);
    highp float band = min(max(edge_depth, 0.1 * minHalf), 0.6 * minHalf);
    highp float depth = borderDepth(p, r);
    if (depth > band + 0.01 && progress >= 0.999 && progress <= 1.0)
        discard;

    highp float glow = bandGlow(depth, band);
    highp float fraction = clamp(depth / band, 0.0, 1.0);
    highp float hexFade = 1.0 - fraction * fraction * (3.0 - 2.0 * fraction);
    highp float outside = clamp((depth + FEATHER) / FEATHER, 0.0, 1.0);

    highp float rc = min(r, 1.0);
    highp float warp = asin(rc) / max(rc, 0.0001);
    highp vec2 q = p * warp;

    highp vec2 cell = hexCell(q * hex_density);
    highp float edge = cell.x;
    highp float id = cell.y;

    highp float form = clamp(progress, 0.0, 1.0);
    highp float shatter = clamp((progress - 1.0) / 0.8, 0.0, 1.0);

    highp float front = distance(p, form_origin) / (1.0 + length(form_origin));
    highp float jitter = (id - 0.5) * 0.06;
    highp float arrival = clamp(front + jitter, 0.0, 1.0) * 0.75;
    highp float age = form - arrival;
    highp float appear = smoothstep(0.0, 0.12, age);
    highp float fresh = appear * (1.0 - smoothstep(0.08, 0.25, age));

    highp float sweep = sin(world.x * 0.7 + world.y * 0.4 - TIME * 2.0);
    highp float glint = sin(world.x * 2.1 - world.y * 1.3 + TIME * 4.0);
    highp float crest = pow(max(sweep, 0.0), 8.0);
    highp float shimmer = 0.85 + 0.15 * sin(TIME * 1.7 + id * 6.2832);

    highp float border = smoothstep(0.42, 0.5, edge);
    highp float fill = fill_level * shimmer * glow;
    highp float lines = line_level * border * hexFade * outside;
    highp float rim = rim_level * 0.5 * glow * (1.0 - smoothstep(0.0, band * 0.3, depth));

    // -- Попадания: белая вспышка в точке, красный нагрев вокруг и яркая волна, бегущая по полосе края
    highp float flash = 0.0;
    highp float heat = 0.0;
    highp float wave = 0.0;
    for (int i = 0; i < 8; i++) {
        if (i >= impact_count)
            break;
        highp float hitAge = impact_age[i];
        highp float strength = impact_strength[i];
        highp float scale = 0.7 + 0.6 * strength;
        highp float d = distance(world, impact_pos[i]) / scale;
        highp float life = clamp(1.0 - hitAge / IMPACT_LIFETIME, 0.0, 1.0);
        highp float flashFade = clamp(1.0 - hitAge / 0.5, 0.0, 1.0);
        flash += strength * flashFade * flashFade * exp(-d * d / 6.0);
        heat += strength * life * life * exp(-d * d / 40.0);
        highp float ring = d - hitAge * WAVE_SPEED;
        wave += strength * sqrt(life) * exp(-ring * ring / 3.0);
    }
    flash = min(flash, 1.5);
    heat = min(heat, 1.0);
    wave = min(wave, 1.5);
    highp float hitBand = max(glow, flash * outside);

    highp float a = (fill + lines + rim + fresh * 0.6 * outside) * appear;
    a *= 1.0 + 0.65 * crest + 0.08 * glint;
    a += (flash * 0.9 + wave * 0.45 + heat * 0.25) * hitBand * outside
        + (wave * 0.6 + flash * 0.8) * line_level * border * hexFade * outside;

    if (shatter > 0.0) {
        highp vec2 fractureUv = q * shard_scale;
        highp vec2 distortion = vec2(vnoise(fractureUv * 1.7),
            vnoise(fractureUv * 1.7 + vec2(8.3, 2.8))) - vec2(0.5);
        highp float cracks = crackDistance(fractureUv + distortion * 0.45);
        highp float spread = clamp(front, 0.0, 1.0) * 0.3
            + vnoise(fractureUv * 0.65) * 0.14;
        highp float threshold = 0.02 + spread + min(cracks, 1.0) * 0.32;
        highp float elapsed = shatter - threshold;
        highp float remaining = 1.0 - smoothstep(0.0, 0.16, elapsed);

        highp float tip = smoothstep(-0.035, 0.0, elapsed)
            * (1.0 - smoothstep(0.0, 0.045, elapsed));
        highp float cracksGlow = tip * (1.0 - smoothstep(0.04, 0.2, cracks));
        a = a * remaining + cracksGlow * 0.55 * appear * outside;
    }

    a *= (1.0 - breath_depth) + breath_depth * sin(TIME * 0.9);

    highp vec3 tint = mix(skin_color.rgb, vec3(1.0, 0.1, 0.12), clamp(heat * 0.8, 0.0, 1.0));
    tint = mix(tint, vec3(1.0), clamp(flash + wave * 0.3, 0.0, 1.0));
    COLOR = vec4(tint * brightness * (1.0 + 0.15 * crest), skin_color.a * clamp(a, 0.0, 0.9));
}
