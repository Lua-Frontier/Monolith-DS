uniform sampler2D SCREEN_TEXTURE;
uniform highp vec3 tint;
uniform highp float strength;

const highp vec3 LUMA = vec3(0.299, 0.587, 0.114);
const highp float HAZE = 0.15;

void fragment() {
    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy);
    highp float lum = dot(color.rgb, LUMA);
    highp vec3 graded = color.rgb * (tint / max(max(tint.r, max(tint.g, tint.b)), 0.001));
    graded *= lum / max(dot(graded, LUMA), 0.001);
    // -- тёмные участки (сам космос) фильтр не трогает, поэтому поверх них ложится слабая дымка цвета туманности
    highp float dark = (1.0 - lum) * (1.0 - lum);
    highp vec3 haze = tint * strength * HAZE * dark;
    COLOR = vec4(clamp(mix(color.rgb, clamp(graded, 0.0, 1.0), strength) + haze, 0.0, 1.0), color.a);
}
