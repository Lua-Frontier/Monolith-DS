uniform sampler2D SCREEN_TEXTURE;
uniform highp vec3 tint;
uniform highp float strength;

const highp vec3 LUMA = vec3(0.299, 0.587, 0.114);

void fragment() {
    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy);
    highp float lum = dot(color.rgb, LUMA);
    highp vec3 graded = clamp(tint * (lum / max(dot(tint, LUMA), 0.05)), 0.0, 1.0);
    COLOR = vec4(mix(color.rgb, graded, strength), color.a);
}
