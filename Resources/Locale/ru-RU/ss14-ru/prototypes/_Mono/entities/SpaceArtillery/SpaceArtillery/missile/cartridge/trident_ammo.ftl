    .ammo-loader-caliber = ASM-220
    .ammo-loader-weight = 190 кг

ent-ShipMissileASM220ECM = торпеда ASM-220 (РЭБ)
ent-Asm220TorpedoECM = торпеда РЭБ ASM-220
    .desc = В отличие от стандартной фугасной торпеды, несёт ЭМИ-заряд и гораздо сильнее бьёт по электронике, зато корпусу почти не вредит.
    .ammo-loader-type = Торпеда (РЭБ)
    .ammo-loader-caliber = ASM-220
    .ammo-loader-weight = 165 кг