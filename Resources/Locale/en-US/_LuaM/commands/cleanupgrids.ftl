cmd-cleanupgrids-desc = Deletes right away every grid that meets the garbage cleanup rules, without waiting for the timer. With the preview argument only lists them.
cmd-cleanupgrids-help = Usage: cleanupgrids [preview]
cmd-cleanupgrids-hint = preview - only list the grids
cmd-cleanupgrids-none = No grids meet the cleanup rules.
cmd-cleanupgrids-preview = Grids that meet the cleanup rules: { $count }
cmd-cleanupgrids-preview-more = ...and { $count } more
cmd-cleanupgrids-done = Grids deleted: { $count }
