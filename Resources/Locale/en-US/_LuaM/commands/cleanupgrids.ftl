cmd-cleanupgrids-desc = Gradually removes abandoned grids without waiting for the usual cleanup timer. The preview argument only lists candidates.
cmd-cleanupgrids-help = Usage: cleanupgrids [preview]
cmd-cleanupgrids-hint = preview - only list the grids
cmd-cleanupgrids-none = No grids meet the cleanup rules.
cmd-cleanupgrids-preview = Grids that meet the cleanup rules: { $count }
cmd-cleanupgrids-preview-more = ...and { $count } more
cmd-cleanupgrids-scheduled = Grid cleanup scheduled. Abandoned grids will be removed gradually.
cmd-cleanupgrids-no-new-pass = Cleanup is already running or there are no grids to check.
