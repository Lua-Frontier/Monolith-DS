trait-luam-cowboy-name = Cowboy
trait-luam-cowboy-desc = You dual wield pistols, revolvers and laser pistols without accuracy penalties and can dual wield sawn-off shotguns. Shotguns, rifles, SMGs, machine guns, sniper and DMR rifles, grenade and rocket launchers, as well as any other energy weapons are not your thing: you won't fire them.
cowboy-cannot-fire = A real cowboy doesn't shoot with that.
cowboy-examine-pistol = [color=#7fbf7f]As a cowboy, you dual wield this weapon without penalties.[/color]
cowboy-examine-sawn-off = [color=#7fbf7f]As a cowboy, you can dual wield this weapon.[/color]
cowboy-examine-forbidden = [color=#c46a6a]As a cowboy, you can not fire this weapon.[/color]
